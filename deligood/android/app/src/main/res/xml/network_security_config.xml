<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- ✅ Autorise les tuiles OpenStreetMap en HTTP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">tile.openstreetmap.org</domain>
        <domain includeSubdomains="true">tiles.stadiamaps.com</domain>
        <domain includeSubdomains="true">deligood-backend.onrender.com</domain>
    </domain-config>

    <!-- Tout le reste reste en HTTPS sécurisé -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

</network-security-config>